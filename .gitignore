# Real board screenshots may contain confidential data; review before making public.
/vendor/
*.tar.gz
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*.log
.env
.env.*
*.pem
*.key
*.secret
# Evidence is NOT auto-published: /evidence/* is ignored by default.
# After reviewing an evidence file for sensitive data (passwords, tokens,
# keys, serials, MACs, IPs), add it intentionally with 'git add -f'.
# The inference log is the one deliberate exception to the *.log rule:
/evidence/*
!/evidence/README.md
!/evidence/06_inference_log.txt
*.mp4
*.mov
*.mkv
